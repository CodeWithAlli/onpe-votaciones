# =============================================
# VARIABLES DE ENTORNO — ONP con Supabase
# Copiar como .env.local y completar los valores
# =============================================

# ---- Supabase ----
# Ir a: supabase.com → tu proyecto → Settings → API

# URL de las Edge Functions (sin /v1 al final)
VITE_SUPABASE_FUNCTIONS_URL=https://TUPROYECTO.supabase.co/functions/v1

# Anon key (pública, es segura ponerla aquí)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- Modo desarrollo ----
# true = usa datos mock locales (sin Supabase)
# false = conecta a Supabase real
VITE_USE_MOCK=false

# ID de la elección activa (del schema.sql)
VITE_ELECCION_ID=a1b2c3d4-0000-0000-0000-000000000001
